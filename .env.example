# Local Docker development settings. Use a generated secret for live deployments.
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
ALLOW_SQLITE=True ## I am using neon postgres database, so I have set this to False. If you are using sqlite, set this to True.

CORS_ALLOWED_ORIGINS=http://localhost:5173

# To use PostgreSQL installed on the Windows host while Django runs in Docker,
# set DATABASE_URL to:
# postgresql://adminuser:<URL_ENCODED_PASSWORD>@host.docker.internal:5432/appdb
# Then set ALLOW_SQLITE=False. Do not use this local URL on Deployment.

# For Render, set DATABASE_URL to the PostgreSQL Internal Database URL in the
# web service's environment. For local Docker, use its External Database URL.
# Never commit the actual database URL or credentials.


# Brevo email verification
EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
BREVO_API_KEY=Get your brevo api key
DEFAULT_FROM_EMAIL=get from brevo
EMAIL_VERIFICATION=True
EMAIL_OTP_EXPIRY_MINUTES=10


# Razorpay test/live credentials. Never commit real credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# Production HTTPS settings (set on the hosting service, not for local HTTP).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
CSRF_TRUSTED_ORIGINS=a=https://yourdomain.com,https://www.yourdomain.com

# Set MEDIA_ROOT to the mount path of a persistent disk or object-storage adapter.
CLOUDINARY_CLOUD_NAME=Cloudinary cloud name
CLOUDINARY_API_KEY=Cloudinary api key
CLOUDINARY_API_SECRET=Cloudinary api secret
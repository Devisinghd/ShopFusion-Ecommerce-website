# Local Docker development settings. Use a generated secret for live deployments.
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
ALLOW_SQLITE=True
CORS_ALLOWED_ORIGINS=http://localhost:5173

# To use PostgreSQL installed on the Windows host while Django runs in Docker,
# set DATABASE_URL to:
# postgresql://adminuser:<URL_ENCODED_PASSWORD>@host.docker.internal:5432/appdb
# Then set ALLOW_SQLITE=False. Do not use this local URL on Render.

# For Render, set DATABASE_URL to the PostgreSQL Internal Database URL in the
# web service's environment. For local Docker, use its External Database URL.
# Never commit the actual database URL or credentials.

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_BACKEND=
EMAIL_VERIFICATION=True
EMAIL_OTP_EXPIRY_MINUTES=10

# Razorpay test/live credentials. Never commit real credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production email: set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and provide the SMTP account credentials in the hosting service environment.

# Production HTTPS settings (set on the hosting service, not for local HTTP).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://your-service.onrender.com
# Set MEDIA_ROOT to the mount path of a persistent disk or object-storage adapter.